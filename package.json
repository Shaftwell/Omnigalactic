{
  "name": "omnigalactic",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "test:rules": "npx --yes firebase-tools@15.23.0 emulators:exec --only firestore --project demo-omnigalactic \"node --test scripts/firestore-rules.emulator.mjs\"",
    "build:e2e": "VITE_USE_FIREBASE_EMULATORS=true VITE_OFFLINE_E2E=true vite build",
    "test:e2e:offline": "npm run build:e2e && npx --yes firebase-tools@15.23.0 emulators:exec --config firebase.e2e.json --only auth,firestore --project demo-omnigalactic-offline \"playwright test\"",
    "test:coverage": "vitest run --coverage",
    "verify:offline": "node scripts/verify-offline-build.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/dompurify": "^3.0.5",
    "@vitejs/plugin-react": "^5.0.4",
    "chrono-node": "^2.9.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.3",
    "firebase": "^12.11.0",
    "firebase-admin": "^13.7.0",
    "lucide-react": "^0.546.0",
    "marked": "^18.0.5",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.4.21",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  }
}