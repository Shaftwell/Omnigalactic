rules_version = '2';

// Per-account rules for Omnigalactic. Anyone with a Google account can sign
// in; every account's data lives under users/{uid} and is readable and
// writable only by that account. There is no shared or cross-account data.
//
// Vendors/Purchases attachment metadata (**/files/{fileId}) is written by the
// /api/files Cloud Function through the Admin SDK, which bypasses these rules;
// client writes to a files subcollection are denied (no rule grants them) so
// the function stays the single owner of attachment metadata and its Storage
// objects. There is deliberately NO recursive wildcard grant here — an
// allow on /{document=**} would OR together with the files deny and defeat it.
service cloud.firestore {
  match /databases/{database}/documents {

    function isMe(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      // The user document itself holds no fields; everything lives in
      // subcollections.
      allow read, write: if false;

      // Top-level per-account collections: events, todos, lists, notes,
      // shoppingItems, people, vendors, purchases, test (connection probe).
      match /{col}/{docId} {
        allow read, write: if isMe(uid);
      }

      // Nested subtrees: budgets/household/{categories|subcategories}/{id}
      // and portfolios/household/{holdings|assetClasses|settings}/{id}.
      match /budgets/{budgetDoc}/{sub}/{docId} {
        allow read, write: if isMe(uid);
      }
      match /portfolios/{portfolioDoc}/{sub}/{docId} {
        allow read, write: if isMe(uid);
      }

      // Attachment metadata: owner-readable, written only by /api/files.
      match /vendors/{vendorId}/files/{fileId} {
        allow read: if isMe(uid);
      }
      match /purchases/{purchaseId}/files/{fileId} {
        allow read: if isMe(uid);
      }
    }

    // Nothing outside users/{uid} is accessible.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
