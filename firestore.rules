rules_version = '2';

// Multi-tenant rules for Omnigalactic. Every piece of content lives under
// sites/{siteId}, and access is gated on the signed-in Google account being
// a member of that site (or holding a pending invitation to it).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isMember(site) {
      return signedIn() && request.auth.uid in site.data.memberUids;
    }

    function isOwner(site) {
      return signedIn() && request.auth.uid == site.data.ownerUid;
    }

    function isInvited(site) {
      return signedIn()
        && 'email' in request.auth.token
        && myEmail() in site.data.invitedEmails;
    }

    match /sites/{siteId} {
      // Members see their sites; invitees can see a site's name/owner so
      // they can decide whether to accept.
      allow read: if isMember(resource) || isInvited(resource);

      // Anyone with a Google account can create their own fresh site, but
      // only as its sole owner and first member.
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail == myEmail()
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.memberEmails == [myEmail()]
        && request.resource.data.invitedEmails == []
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100;

      // Members can rename the site and manage invitations/membership,
      // but never change who owns it. An invited non-member may perform
      // exactly one write: adding themselves as a member and clearing
      // their own invitation.
      allow update: if
        (
          isMember(resource)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.ownerEmail == resource.data.ownerEmail
          && request.auth.uid in request.resource.data.memberUids
        ) || (
          isInvited(resource)
          && !isMember(resource)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['memberUids', 'memberEmails', 'invitedEmails'])
          && request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid])
          && request.resource.data.memberEmails == resource.data.memberEmails.concat([myEmail()])
          && request.resource.data.invitedEmails == resource.data.invitedEmails.removeAll([myEmail()])
        );

      // Only the owner may delete a site.
      allow delete: if isOwner(resource);

      // All site content (tasks, shopping, notes, and any future
      // collections) is readable and writable by members only.
      match /{collection}/{docId} {
        allow read, write: if isMember(get(/databases/$(database)/documents/sites/$(siteId)));
      }
    }

    // Nothing else is accessible.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
