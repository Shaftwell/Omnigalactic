{
  "firestore": {
    "database": "(default)",
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions"
  },
  "storage": [
    {
      "bucket": "omnigalactic-e668d.firebasestorage.app",
      "rules": "storage.rules"
    }
  ],
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/quotes",
        "function": "quotes"
      },
      {
        "source": "/api/files",
        "function": "files"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}