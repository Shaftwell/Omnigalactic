// Generated by the Omnigalactic Invest tab. Do not edit by hand.
// How to use: open any chart on TradingView, open the "Pine Editor" panel,
// paste this entire script, and click "Add to chart".
// This script is a snapshot of your holdings. After editing them in the
// app, press the "TradingView script" button again to recompute it.

//@version=6
indicator("Omnigalactic Portfolio Allocation", overlay=false)

driftThreshold = 5

price0 = request.security("NASDAQ:AAPL", timeframe.period, close)
val0 = 10 * price0
price1 = request.security("AMEX:SPY", timeframe.period, close)
val1 = 5 * price1
price2 = request.security("BITSTAMP:BTCUSD", timeframe.period, close)
val2 = 0.25 * price2

total = nz(val0) + nz(val1) + nz(val2)

w0 = total > 0 ? val0 / total * 100 : na
d0 = w0 - 40
w1 = total > 0 ? val1 / total * 100 : na
d1 = w1 - 35
w2 = total > 0 ? val2 / total * 100 : na
d2 = w2 - 25

maxAbsDrift = 0.0
maxAbsDrift := math.max(maxAbsDrift, math.abs(nz(d0)))
maxAbsDrift := math.max(maxAbsDrift, math.abs(nz(d1)))
maxAbsDrift := math.max(maxAbsDrift, math.abs(nz(d2)))

plot(total, "Portfolio value", color=color.teal, linewidth=2)

var table t = table.new(position.top_right, 7, 5, bgcolor=color.new(color.black, 80), border_width=1, border_color=color.new(color.gray, 60))
if barstate.islast
    table.cell(t, 0, 0, "Symbol", text_color=color.white, bgcolor=color.new(color.gray, 40))
    table.cell(t, 1, 0, "Qty", text_color=color.white, bgcolor=color.new(color.gray, 40))
    table.cell(t, 2, 0, "Price", text_color=color.white, bgcolor=color.new(color.gray, 40))
    table.cell(t, 3, 0, "Value", text_color=color.white, bgcolor=color.new(color.gray, 40))
    table.cell(t, 4, 0, "Weight %", text_color=color.white, bgcolor=color.new(color.gray, 40))
    table.cell(t, 5, 0, "Target %", text_color=color.white, bgcolor=color.new(color.gray, 40))
    table.cell(t, 6, 0, "Drift", text_color=color.white, bgcolor=color.new(color.gray, 40))
    table.cell(t, 0, 1, "NASDAQ:AAPL", text_color=color.white)
    table.cell(t, 1, 1, "10", text_color=color.white)
    table.cell(t, 2, 1, na(price0) ? "…" : str.tostring(price0, '#.##'), text_color=color.white)
    table.cell(t, 3, 1, na(val0) ? "…" : str.tostring(val0, '#.##'), text_color=color.white)
    table.cell(t, 4, 1, na(w0) ? "…" : str.tostring(w0, '#.#'), text_color=color.white)
    table.cell(t, 5, 1, "40", text_color=color.white)
    table.cell(t, 6, 1, na(d0) ? "…" : str.tostring(d0, '#.#'), text_color=color.white, bgcolor=not na(d0) and math.abs(d0) > driftThreshold ? color.new(color.red, 60) : color.new(color.gray, 70))
    table.cell(t, 0, 2, "AMEX:SPY", text_color=color.white)
    table.cell(t, 1, 2, "5", text_color=color.white)
    table.cell(t, 2, 2, na(price1) ? "…" : str.tostring(price1, '#.##'), text_color=color.white)
    table.cell(t, 3, 2, na(val1) ? "…" : str.tostring(val1, '#.##'), text_color=color.white)
    table.cell(t, 4, 2, na(w1) ? "…" : str.tostring(w1, '#.#'), text_color=color.white)
    table.cell(t, 5, 2, "35", text_color=color.white)
    table.cell(t, 6, 2, na(d1) ? "…" : str.tostring(d1, '#.#'), text_color=color.white, bgcolor=not na(d1) and math.abs(d1) > driftThreshold ? color.new(color.red, 60) : color.new(color.gray, 70))
    table.cell(t, 0, 3, "BITSTAMP:BTCUSD", text_color=color.white)
    table.cell(t, 1, 3, "0.25", text_color=color.white)
    table.cell(t, 2, 3, na(price2) ? "…" : str.tostring(price2, '#.##'), text_color=color.white)
    table.cell(t, 3, 3, na(val2) ? "…" : str.tostring(val2, '#.##'), text_color=color.white)
    table.cell(t, 4, 3, na(w2) ? "…" : str.tostring(w2, '#.#'), text_color=color.white)
    table.cell(t, 5, 3, "25", text_color=color.white)
    table.cell(t, 6, 3, na(d2) ? "…" : str.tostring(d2, '#.#'), text_color=color.white, bgcolor=not na(d2) and math.abs(d2) > driftThreshold ? color.new(color.red, 60) : color.new(color.gray, 70))
    table.cell(t, 0, 4, "TOTAL", text_color=color.white, bgcolor=color.new(color.gray, 40))
    table.cell(t, 1, 4, "", bgcolor=color.new(color.gray, 40))
    table.cell(t, 2, 4, "", bgcolor=color.new(color.gray, 40))
    table.cell(t, 3, 4, str.tostring(total, '#.##'), text_color=color.white, bgcolor=color.new(color.gray, 40))
    table.cell(t, 4, 4, total > 0 ? "100" : "…", text_color=color.white, bgcolor=color.new(color.gray, 40))
    table.cell(t, 5, 4, "100", text_color=color.white, bgcolor=color.new(color.gray, 40))
    table.cell(t, 6, 4, "", bgcolor=color.new(color.gray, 40))

alertcondition(maxAbsDrift > driftThreshold, title="Portfolio drift alert", message="A holding drifted more than 5% from its target allocation.")
